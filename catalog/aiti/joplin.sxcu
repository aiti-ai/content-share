{
  "Name": "Joplin",
  "DestinationType": "TextUploader",
  "RequestMethod": "POST",
  "RequestURL": "http://localhost:41184/notes?token=<token>",
  "Body": "JSON",
  "Data": "{\"title\":\"{{title}}\",\"body\":\"{{content}}\"}",
  "Headers": { "Content-Type": "application/json" },
  "URL": "joplin://x-callback-url/openNote?id=$json:id$"
}
